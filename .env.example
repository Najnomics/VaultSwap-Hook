# VaultSwap Hook Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Ethereum Mainnet
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
MAINNET_PRIVATE_KEY=your_mainnet_private_key_here

# Sepolia Testnet
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_here

# Arbitrum Mainnet
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_PRIVATE_KEY=your_arbitrum_private_key_here

# Arbitrum Sepolia Testnet
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_PRIVATE_KEY=your_arbitrum_sepolia_private_key_here

# =============================================================================
# API KEYS
# =============================================================================

# Etherscan API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# =============================================================================
# EIGENLAYER CONFIGURATION
# =============================================================================

# EigenLayer Contract Addresses
EIGENLAYER_ALLOCATION_MANAGER=0x1234567890123456789012345678901234567890
EIGENLAYER_KEY_REGISTRAR=0x1234567890123456789012345678901234567890
EIGENLAYER_PERMISSION_CONTROLLER=0x1234567890123456789012345678901234567890

# =============================================================================
# FHENIX CONFIGURATION
# =============================================================================

# Fhenix Network URLs
FHENIX_MAINNET_RPC_URL=https://mainnet.fhenix.zone
FHENIX_TESTNET_RPC_URL=https://testnet.fhenix.zone

# =============================================================================
# VAULTSWAP CONFIGURATION
# =============================================================================

# VaultSwap Contract Addresses (will be set after deployment)
VAULTSWAP_HOOK_ADDRESS=
VAULTSWAP_TOKEN_ADDRESS=
VAULTSWAP_ANALYTICS_ADDRESS=

# MEV Protection Configuration
MEV_PROTECTION_LEVEL=3
DECOY_ORDER_ENABLED=true
EXECUTION_DELAY=300

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Local Development
ANVIL_RPC_URL=http://localhost:8545
ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Test Configuration
TEST_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
